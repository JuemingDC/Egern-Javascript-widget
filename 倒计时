/**
 * Apple-style Liquid Glass Countdown Widget
 * 逻辑修正：到目标“日历日”即显示 0 天
 */

const env = ctx.env || {}

const TITLE = env.TITLE || "Countdown"
const TZ = Number(env.TZ_OFFSET || 8)
const MAX = Number(env.MAX_ITEMS || 4)

function tzNow() {
  const now = new Date()
  const utc = now.getTime() + now.getTimezoneOffset() * 60000
  return new Date(utc + TZ * 3600000)
}

function dayDiff(dateStr) {
  if (!dateStr) return null

  const now = tzNow()

  const [y, m, d] = dateStr.split("-").map(Number)
  const target = new Date(y, m - 1, d)

  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())

  const diff = Math.floor((target - today) / 86400000)

  return diff < 0 ? 0 : diff
}

let items = []

for (let i = 1; i <= 8; i++) {
  const name = env[`NAME${i}`]
  const date = env[`DATE${i}`]
  const detail = env[`DETAIL${i}`]

  if (!name || !date) continue

  const left = dayDiff(date)

  items.push({
    name,
    left,
    detail
  })
}

items = items
  .sort((a, b) => a.left - b.left)
  .slice(0, MAX)

const scale = items.length >= 4 ? 0.9 : 1
const gap = items.length >= 4 ? 8 : 12

function progress(left) {
  const total = 30
  const p = 1 - left / total
  return Math.max(0, Math.min(1, p))
}

function bar(p) {
  return {
    type: "stack",
    height: 6 * scale,
    background: {
      light: "rgba(0,0,0,0.08)",
      dark: "rgba(255,255,255,0.12)"
    },
    cornerRadius: 3,
    children: [
      {
        type: "stack",
        width: `${p * 100}%`,
        backgroundGradient: {
          colors: [
            { light: "#5AC8FA", dark: "#64D2FF" },
            { light: "#007AFF", dark: "#0A84FF" }
          ],
          startPoint: { x: 0, y: 0 },
          endPoint: { x: 1, y: 0 }
        },
        cornerRadius: 3
      }
    ]
  }
}

return {
  type: "widget",
  padding: 14,
  backgroundGradient: {
    colors: [
      { light: "#F2F2F7", dark: "#1C1C1E" },
      { light: "#E5E5EA", dark: "#2C2C2E" }
    ],
    startPoint: { x: 0, y: 0 },
    endPoint: { x: 1, y: 1 }
  },
  children: [
    {
      type: "stack",
      horizontal: true,
      children: [
        {
          type: "text",
          text: TITLE,
          fontSize: 12,
          fontWeight: 500,
          color: {
            light: "#8E8E93",
            dark: "#8E8E93"
          }
        },
        { type: "spacer" },
        {
          type: "date",
          style: "time",
          fontSize: 12,
          color: {
            light: "#8E8E93",
            dark: "#8E8E93"
          }
        }
      ]
    },

    { type: "spacer", size: 10 },

    ...items.map(it => ({
      type: "stack",
      vertical: true,
      gap: 4,
      children: [
        {
          type: "stack",
          horizontal: true,
          children: [
            {
              type: "text",
              text: it.name,
              fontSize: 16 * scale,
              fontWeight: 600,
              color: {
                light: "#000000",
                dark: "#FFFFFF"
              }
            },
            { type: "spacer" },
            {
              type: "text",
              text: `${it.left}`,
              fontSize: 20 * scale,
              fontWeight: 700,
              color: {
                light: "#007AFF",
                dark: "#0A84FF"
              }
            }
          ]
        },

        bar(progress(it.left)),

        it.detail
          ? {
              type: "text",
              text: it.detail,
              fontSize: 12 * scale,
              color: {
                light: "#8E8E93",
                dark: "#8E8E93"
              }
            }
          : null
      ].filter(Boolean)
    }))
  ]
}
