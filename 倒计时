export default async function(ctx) {
  const env = ctx.env || {}

  const TITLE = env.TITLE || "倒计时"
  const TZ = Number(env.TZ_OFFSET || 8)
  const MAX = Math.max(1, Math.min(Number(env.MAX_ITEMS || 4), 6))

  function getTzNow(offset) {
    const now = new Date()
    const utc = now.getTime() + now.getTimezoneOffset() * 60 * 1000
    return new Date(utc + offset * 60 * 60 * 1000)
  }

  function calcDaysLeft(dateStr, offset) {
    if (!dateStr) return null

    const now = getTzNow(offset)
    const parts = String(dateStr).split("-").map(Number)
    if (parts.length !== 3 || parts.some(Number.isNaN)) return null

    const [y, m, d] = parts

    const todayStart = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate())
    const targetStart = Date.UTC(y, m - 1, d)

    const diff = Math.floor((targetStart - todayStart) / 86400000)
    return diff < 0 ? 0 : diff
  }

  function buildProgressBar(daysLeft) {
    const horizon = 30
    const ratio = Math.max(0, Math.min(1, 1 - daysLeft / horizon))

    return {
      type: "stack",
      height: 6,
      cornerRadius: 999,
      backgroundColor: {
        light: "#00000014",
        dark: "#FFFFFF1A"
      },
      children: [
        {
          type: "stack",
          width: `${Math.max(8, ratio * 100)}%`,
          height: 6,
          cornerRadius: 999,
          backgroundColor: {
            light: "#7FB3FF",
            dark: "#5AA9FF"
          }
        }
      ]
    }
  }

  const items = []
  for (let i = 1; i <= 6; i++) {
    const name = env[`NAME${i}`]
    const date = env[`DATE${i}`]
    const detail = env[`DETAIL${i}`]

    if (!name || !date) continue

    const left = calcDaysLeft(date, TZ)
    if (left === null) continue

    items.push({
      name: String(name),
      date: String(date),
      detail: detail ? String(detail) : "",
      left
    })
  }

  items.sort((a, b) => a.left - b.left)
  const showItems = items.slice(0, MAX)

  const compact = showItems.length >= 4
  const nameFont = compact ? 15 : 17
  const dayFont = compact ? 22 : 24
  const metaFont = 12
  const sectionGap = compact ? 8 : 10
  const contentGap = compact ? 10 : 12

  const children = [
    {
      type: "stack",
      direction: "horizontal",
      children: [
        {
          type: "text",
          text: TITLE,
          font: {
            size: 12,
            weight: "medium"
          },
          textColor: {
            light: "#7C7C80",
            dark: "#8E8E93"
          }
        },
        {
          type: "spacer"
        },
        {
          type: "date",
          style: "time",
          font: {
            size: 12,
            weight: "regular"
          },
          textColor: {
            light: "#9A9AA0",
            dark: "#8E8E93"
          }
        }
      ]
    },
    {
      type: "spacer",
      length: 10
    }
  ]

  if (showItems.length === 0) {
    children.push({
      type: "text",
      text: "请设置 NAME1 / DATE1 等环境变量",
      font: {
        size: 13,
        weight: "regular"
      },
      textColor: {
        light: "#8E8E93",
        dark: "#8E8E93"
      }
    })
  } else {
    showItems.forEach((item, index) => {
      children.push({
        type: "stack",
        direction: "vertical",
        spacing: sectionGap,
        children: [
          {
            type: "stack",
            direction: "horizontal",
            children: [
              {
                type: "text",
                text: item.name,
                font: {
                  size: nameFont,
                  weight: "semibold"
                },
                textColor: {
                  light: "#111111",
                  dark: "#FFFFFF"
                }
              },
              {
                type: "spacer"
              },
              {
                type: "text",
                text: `${item.left}`,
                font: {
                  size: dayFont,
                  weight: "bold"
                },
                textColor: {
                  light: "#3A7BFF",
                  dark: "#63A4FF"
                }
              },
              {
                type: "text",
                text: " 天",
                font: {
                  size: 13,
                  weight: "medium"
                },
                textColor: {
                  light: "#7C7C80",
                  dark: "#8E8E93"
                }
              }
            ]
          },
          buildProgressBar(item.left),
          {
            type: "stack",
            direction: "horizontal",
            children: [
              {
                type: "text",
                text: item.date,
                font: {
                  size: metaFont,
                  weight: "regular"
                },
                textColor: {
                  light: "#8E8E93",
                  dark: "#8E8E93"
                }
              },
              {
                type: "spacer"
              },
              {
                type: "text",
                text: item.detail || "",
                font: {
                  size: metaFont,
                  weight: "regular"
                },
                textColor: {
                  light: "#8E8E93",
                  dark: "#8E8E93"
                }
              }
            ]
          }
        ]
      })

      if (index !== showItems.length - 1) {
        children.push({
          type: "spacer",
          length: contentGap
        })
      }
    })
  }

  return {
    type: "widget",
    padding: 16,
    spacing: 0,
    backgroundColor: {
      light: "#F2F2F7",
      dark: "#1C1C1E"
    },
    children
  }
}
