export default async function (ctx) {
  const env = ctx.env || {};
  const family = ctx.widgetFamily || "systemMedium";

  function parseDate(input) {
    if (!input) return null;
    const text = String(input).trim().replace(/\//g, "-").replace(/\./g, "-");
    const m = text.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
    if (m) {
      const y = Number(m[1]);
      const mo = Number(m[2]) - 1;
      const d = Number(m[3]);
      const dt = new Date(y, mo, d);
      return isNaN(dt.getTime()) ? null : dt;
    }
    const dt = new Date(text);
    return isNaN(dt.getTime()) ? null : dt;
  }

  function startOfDay(dt) {
    return new Date(dt.getFullYear(), dt.getMonth(), dt.getDate());
  }

  function getDaysLeft(target) {
    if (!target) return null;
    const today = startOfDay(new Date());
    const targetDay = startOfDay(target);
    const diff = Math.ceil((targetDay.getTime() - today.getTime()) / 86400000);
    return diff < 0 ? 0 : diff;
  }

  function shortDate(dt) {
    if (!dt) return "--.--";
    const m = String(dt.getMonth() + 1).padStart(2, "0");
    const d = String(dt.getDate()).padStart(2, "0");
    return `${m}.${d}`;
  }

  function getItems() {
    const list = [];

    for (let i = 1; i <= 20; i++) {
      const name = env["NAME" + i];
      const date = env["DATE" + i];
      const detail = env["DETAIL" + i];

      if (!name && !date && !detail) continue;

      const dt = parseDate(date);
      list.push({
        name: name || ("Target " + i),
        detail: detail || "",
        date: dt,
        shortDate: shortDate(dt),
        days: getDaysLeft(dt),
      });
    }

    if (list.length === 0 && (env.NAME || env.DATE || env.DETAIL)) {
      const dt = parseDate(env.DATE);
      list.push({
        name: env.NAME || "Target",
        detail: env.DETAIL || "",
        date: dt,
        shortDate: shortDate(dt),
        days: getDaysLeft(dt),
      });
    }

    list.sort((a, b) => {
      const ad = a.days === null ? 999999 : a.days;
      const bd = b.days === null ? 999999 : b.days;
      return ad - bd;
    });

    return list;
  }

  function getMaxCount(family) {
    if (family === "systemSmall") return 1;
    if (family === "systemMedium") return 2;
    if (family === "systemLarge") return 4;
    if (family === "systemExtraLarge") return 6;
    return 2;
  }

  function relativeText(days) {
    if (days === null) return "pending";
    if (days === 0) return "today";
    if (days === 1) return "tomorrow";
    if (days <= 7) return `in ${days} days`;
    if (days <= 30) return `${days} days left`;
    return "scheduled";
  }

  function progressRatio(days) {
    if (days === null) return 0.2;
    if (days === 0) return 1;
    const capped = days > 60 ? 60 : days;
    return (60 - capped) / 60;
  }

  function getTone(days) {
    if (days === null) {
      return {
        strong: { light: "#7F7367", dark: "#D7C5B3" },
        text: { light: "#231D18", dark: "#F4E8DC" },
        sub: { light: "#8A7B6D", dark: "#B9AA99" },
        meta: { light: "#8E8173", dark: "#C8B9A7" },
        track: { light: "#E8DED2", dark: "#463A31" },
        fill: { light: "#BBAE9E", dark: "#8E7B68" },
        dot: { light: "#A49482", dark: "#BDAA96" },
        divider: { light: "#D8CCBE", dark: "#51473D" }
      };
    }
    if (days <= 3) {
      return {
        strong: { light: "#B14A3D", dark: "#F1A79B" },
        text: { light: "#231D18", dark: "#F4E8DC" },
        sub: { light: "#966B64", dark: "#D0A59C" },
        meta: { light: "#A55E52", dark: "#E7B4AA" },
        track: { light: "#F0D9D4", dark: "#4D2E2A" },
        fill: { light: "#C85A4B", dark: "#E09A90" },
        dot: { light: "#AF4C3F", dark: "#F0A195" },
        divider: { light: "#E4B9AE", dark: "#6A4038" }
      };
    }
    if (days <= 14) {
      return {
        strong: { light: "#AD7A2F", dark: "#E6C27F" },
        text: { light: "#231D18", dark: "#F4E8DC" },
        sub: { light: "#8B7861", dark: "#C8B391" },
        meta: { light: "#92703E", dark: "#E4C58C" },
        track: { light: "#EEE2CC", dark: "#463824" },
        fill: { light: "#C18A38", dark: "#D7B16E" },
        dot: { light: "#A8772E", dark: "#E2BC77" },
        divider: { light: "#DFC9A6", dark: "#655038" }
      };
    }
    if (days <= 30) {
      return {
        strong: { light: "#6F819C", dark: "#C0CCDB" },
        text: { light: "#231D18", dark: "#F4E8DC" },
        sub: { light: "#7C808A", dark: "#AEB7C4" },
        meta: { light: "#6C7D97", dark: "#B7C5D7" },
        track: { light: "#DFE6EF", dark: "#313B49" },
        fill: { light: "#7E95B3", dark: "#B2C1D4" },
        dot: { light: "#7087A5", dark: "#C3D0DF" },
        divider: { light: "#C8D3E2", dark: "#485466" }
      };
    }
    return {
      strong: { light: "#7E8796", dark: "#C6CDD7" },
      text: { light: "#231D18", dark: "#F4E8DC" },
      sub: { light: "#8B9098", dark: "#AAB1BA" },
      meta: { light: "#7F8795", dark: "#BBC3CF" },
      track: { light: "#E6E9EE", dark: "#333741" },
      fill: { light: "#98A2B1", dark: "#B6BEC9" },
      dot: { light: "#8992A0", dark: "#C0C7D0" },
      divider: { light: "#D8DCE2", dark: "#474C55" }
    };
  }

  function makeDivider(color) {
    return {
      type: "stack",
      height: 1,
      backgroundColor: color
    };
  }

  function makeProgress(days, tone, compact) {
    const ratio = progressRatio(days);
    const total = compact ? 148 : 190;
    const fill = Math.max(14, Math.round(total * ratio));
    const dotOffset = Math.max(10, Math.min(total - 8, fill));

    return {
      type: "stack",
      width: total,
      height: 4,
      backgroundColor: tone.track,
      borderRadius: 999,
      children: [
        {
          type: "stack",
          width: fill,
          height: 4,
          backgroundColor: tone.fill,
          borderRadius: 999
        },
        {
          type: "stack",
          width: 6,
          height: 6,
          backgroundColor: tone.dot,
          borderRadius: 999,
          offset: { x: dotOffset - 3, y: -1 }
        }
      ]
    };
  }

  function makeItem(item, compact) {
    const tone = getTone(item.days);

    return {
      type: "stack",
      direction: "column",
      gap: compact ? 6 : 8,
      padding: compact ? [8, 0, 8, 0] : [10, 0, 10, 0],
      children: [
        {
          type: "stack",
          direction: "row",
          alignItems: "start",
          children: [
            {
              type: "stack",
              direction: "column",
              flex: 1,
              gap: 0,
              children: [
                {
                  type: "text",
                  text: item.name,
                  font: { size: compact ? "headline" : "title3", weight: "bold" },
                  textColor: tone.text,
                  maxLines: 1,
                  minScale: 0.56,
                  textAlign: "left"
                },
                {
                  type: "text",
                  text: item.detail || " ",
                  font: { size: "caption1", weight: "regular" },
                  textColor: tone.sub,
                  maxLines: 1,
                  minScale: 0.68,
                  textAlign: "left"
                }
              ]
            },
            {
              type: "stack",
              direction: "row",
              alignItems: "start",
              padding: [0, 0, compact ? 6 : 8, 0],
              children: [
                {
                  type: "text",
                  text: item.days === null ? "--" : String(item.days),
                  font: { size: compact ? "largeTitle" : "title", weight: "bold" },
                  textColor: tone.strong,
                  maxLines: 1,
                  minScale: 0.5
                },
                {
                  type: "text",
                  text: "d",
                  font: { size: "caption2", weight: "semibold" },
                  textColor: tone.meta,
                  maxLines: 1
                }
              ]
            }
          ]
        },
        {
          type: "stack",
          direction: "row",
          alignItems: "center",
          gap: 8,
          children: [
            {
              type: "text",
              text: `${item.shortDate} · ${relativeText(item.days)}`,
              font: { size: compact ? "caption1" : "body", weight: "medium" },
              textColor: tone.meta,
              maxLines: 1,
              minScale: 0.72,
              textAlign: "left"
            }
          ]
        },
        makeProgress(item.days, tone, compact)
      ]
    };
  }

  const items = getItems();
  const visible = items.slice(0, getMaxCount(family));
  const compact = family === "systemSmall" || family === "systemMedium";

  if (items.length === 0) {
    return {
      type: "widget",
      padding: 14,
      gap: 8,
      backgroundGradient: {
        type: "linear",
        colors: [
          { light: "#F4EDE2", dark: "#2A231C" },
          { light: "#E8DCCE", dark: "#1D1813" }
        ],
        stops: [0, 1],
        startPoint: { x: 0, y: 0 },
        endPoint: { x: 1, y: 1 }
      },
      children: [
        {
          type: "stack",
          direction: "row",
          children: [
            {
              type: "text",
              text: "Countdown",
              font: { size: "caption2", weight: "medium" },
              textColor: { light: "#8C7D6C", dark: "#BAAA98" },
              maxLines: 1
            },
            { type: "spacer" }
          ]
        },
        { type: "spacer" },
        {
          type: "text",
          text: "No target configured",
          font: { size: "headline", weight: "semibold" },
          textColor: { light: "#302821", dark: "#F0E5D9" },
          maxLines: 1,
          textAlign: "center",
          minScale: 0.7
        },
        {
          type: "text",
          text: "Use NAME1 / DATE1 / DETAIL1",
          font: { size: "caption1", weight: "regular" },
          textColor: { light: "#7B6E61", dark: "#B6A899" },
          maxLines: 2,
          textAlign: "center"
        },
        { type: "spacer" }
      ]
    };
  }

  const children = [
    {
      type: "stack",
      direction: "row",
      alignItems: "center",
      children: [
        {
          type: "text",
          text: "Countdown",
          font: { size: "caption2", weight: "medium" },
          textColor: { light: "#8C7D6C", dark: "#BAAA98" },
          maxLines: 1
        },
        { type: "spacer" },
        {
          type: "text",
          text: `${items.length} ITEMS`,
          font: { size: "caption2", weight: "medium" },
          textColor: { light: "#A09081", dark: "#AD9D8D" },
          maxLines: 1
        }
      ]
    }
  ];

  for (let i = 0; i < visible.length; i++) {
    children.push(makeItem(visible[i], compact));
    if (i !== visible.length - 1) {
      children.push(makeDivider(getTone(visible[i].days).divider));
    }
  }

  return {
    type: "widget",
    padding: family === "systemLarge" || family === "systemExtraLarge" ? 14 : 13,
    gap: compact ? 2 : 4,
    backgroundGradient: {
      type: "linear",
      colors: [
        { light: "#F4EDE2", dark: "#2A231C" },
        { light: "#E8DCCE", dark: "#1D1813" }
      ],
      stops: [0, 1],
      startPoint: { x: 0, y: 0 },
      endPoint: { x: 1, y: 1 }
    },
    children: children
  };
}
