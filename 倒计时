function urgencyPill(goal) {
  return {
    type: 'stack',
    direction: 'row',
    padding: [5, 9, 5, 9],
    backgroundColor: goal.palette.accentSoft,
    borderRadius: 999,
    children: [
      {
        type: 'text',
        text: shortUrgency(goal),
        font: { size: 'caption2', weight: 'bold' },
        textColor: goal.palette.accent,
      },
    ],
  };
}

function shortUrgency(goal) {
  switch (goal.urgency) {
    case 'critical':
      return '紧急';
    case 'urgent':
      return '临近';
    case 'soon':
      return '本周';
    case 'normal':
      return '进行中';
    case 'expired':
      return '已截止';
    default:
      return '充裕';
  }
}

function glassBackground(palette) {
  return {
    type: 'linear',
    colors: [
      palette.gradA,
      palette.gradB,
      palette.gradC,
    ],
    stops: [0, 0.62, 1],
    startPoint: { x: 0, y: 0 },
    endPoint: { x: 1, y: 1 },
  };
}
