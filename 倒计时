export default async function (ctx) {
  const env = ctx.env || {};
  const family = ctx.widgetFamily || "systemMedium";

  function parseDate(input) {
    if (!input) return null;
    const text = String(input).trim().replace(/\//g, "-").replace(/\./g, "-");
    const m = text.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
    if (m) {
      const y = Number(m[1]);
      const mo = Number(m[2]) - 1;
      const d = Number(m[3]);
      const dt = new Date(y, mo, d);
      return isNaN(dt.getTime()) ? null : dt;
    }
    const dt = new Date(text);
    return isNaN(dt.getTime()) ? null : dt;
  }

  function startOfDay(dt) {
    return new Date(dt.getFullYear(), dt.getMonth(), dt.getDate());
  }

  function getDaysLeft(target) {
    if (!target) return null;
    const today = startOfDay(new Date());
    const targetDay = startOfDay(target);
    const diff = Math.ceil((targetDay.getTime() - today.getTime()) / 86400000);
    return diff < 0 ? 0 : diff;
  }

  function formatDate(dt) {
    if (!dt) return "Invalid date";
    const y = dt.getFullYear();
    const m = String(dt.getMonth() + 1).padStart(2, "0");
    const d = String(dt.getDate()).padStart(2, "0");
    return y + "." + m + "." + d;
  }

  function getItems() {
    const list = [];

    for (let i = 1; i <= 20; i++) {
      const name = env["NAME" + i];
      const date = env["DATE" + i];
      const detail = env["DETAIL" + i];

      if (!name && !date && !detail) continue;

      const dt = parseDate(date);
      list.push({
        name: name || ("Target " + i),
        detail: detail || "",
        date: dt,
        dateText: formatDate(dt),
        days: getDaysLeft(dt),
      });
    }

    if (list.length === 0 && (env.NAME || env.DATE || env.DETAIL)) {
      const dt = parseDate(env.DATE);
      list.push({
        name: env.NAME || "Target",
        detail: env.DETAIL || "",
        date: dt,
        dateText: formatDate(dt),
        days: getDaysLeft(dt),
      });
    }

    list.sort(function (a, b) {
      const ad = a.days === null ? 999999 : a.days;
      const bd = b.days === null ? 999999 : b.days;
      return ad - bd;
    });

    return list;
  }

  function getMaxCount(family) {
    if (family === "systemSmall") return 1;
    if (family === "systemMedium") return 2;
    if (family === "systemLarge") return 4;
    if (family === "systemExtraLarge") return 6;
    return 2;
  }

  function getAccent(days) {
    if (days === null) {
      return {
        strong: { light: "#7A6F63", dark: "#CBBEAF" },
        softBg: { light: "#EFE7DD", dark: "#3A322B" },
        line: { light: "#D8CCBF", dark: "#5B4E43" }
      };
    }
    if (days <= 3) {
      return {
        strong: { light: "#9C3E2E", dark: "#F0A08D" },
        softBg: { light: "#F5E3DE", dark: "#4A2C27" },
        line: { light: "#DEB2A8", dark: "#7B4B42" }
      };
    }
    if (days <= 14) {
      return {
        strong: { light: "#A56A2A", dark: "#E2BE86" },
        softBg: { light: "#F4EBDD", dark: "#473825" },
        line: { light: "#D8C19D", dark: "#6F5A3C" }
      };
    }
    return {
      strong: { light: "#5F6F86", dark: "#B9C7D8" },
      softBg: { light: "#EAEFF5", dark: "#2E3743" },
      line: { light: "#C5D0DC", dark: "#4C5969" }
    };
  }

  function badgeText(days) {
    if (days === null) return "INVALID";
    if (days === 0) return "TODAY";
    if (days <= 3) return "URGENT";
    if (days <= 14) return "UPCOMING";
    return "PLANNED";
  }

  function card(item, compact) {
    const accent = getAccent(item.days);

    return {
      type: "stack",
      direction: "column",
      gap: compact ? 6 : 8,
      padding: compact ? [10, 12, 10, 12] : [12, 14, 12, 14],
      backgroundColor: { light: "#FFFDF9", dark: "#221E1A" },
      borderRadius: 18,
      borderWidth: 1,
      borderColor: accent.line,
      children: [
        {
          type: "stack",
          direction: "row",
          alignItems: "start",
          children: [
            {
              type: "stack",
              direction: "column",
              gap: 3,
              flex: 1,
              children: [
                {
                  type: "text",
                  text: item.name,
                  font: { size: compact ? "body" : "headline", weight: "semibold" },
                  textColor: { light: "#2E2721", dark: "#F2E9DF" },
                  maxLines: compact ? 1 : 2,
                  minScale: 0.7
                },
                {
                  type: "text",
                  text: item.detail || " ",
                  font: { size: "caption1", weight: "regular" },
                  textColor: { light: "#786D62", dark: "#BEB1A4" },
                  maxLines: compact ? 1 : 2,
                  minScale: 0.7
                }
              ]
            },
            { type: "spacer", length: 8 },
            {
              type: "stack",
              direction: "column",
              alignItems: "end",
              children: [
                {
                  type: "text",
                  text: item.days === null ? "--" : String(item.days),
                  font: { size: compact ? "title2" : "title", weight: "bold" },
                  textColor: accent.strong,
                  maxLines: 1,
                  minScale: 0.6
                },
                {
                  type: "text",
                  text: "days",
                  font: { size: "caption2", weight: "medium" },
                  textColor: { light: "#7A6F63", dark: "#B9AB9D" },
                  maxLines: 1
                }
              ]
            }
          ]
        },
        {
          type: "stack",
          direction: "row",
          alignItems: "center",
          gap: 6,
          children: [
            {
              type: "image",
              src: "sf-symbol:calendar",
              color: accent.strong,
              width: 12,
              height: 12
            },
            {
              type: "text",
              text: item.dateText,
              font: { size: "caption1", weight: "medium" },
              textColor: { light: "#5D534A", dark: "#D3C6B7" },
              maxLines: 1,
              minScale: 0.8
            },
            { type: "spacer" },
            {
              type: "stack",
              padding: [4, 8, 4, 8],
              backgroundColor: accent.softBg,
              borderRadius: 999,
              children: [
                {
                  type: "text",
                  text: badgeText(item.days),
                  font: { size: "caption2", weight: "medium" },
                  textColor: accent.strong,
                  maxLines: 1
                }
              ]
            }
          ]
        }
      ]
    };
  }

  const items = getItems();
  const visible = items.slice(0, getMaxCount(family));

  if (items.length === 0) {
    return {
      type: "widget",
      padding: 16,
      gap: 10,
      backgroundGradient: {
        type: "linear",
        colors: [
          { light: "#F5EEE4", dark: "#2B241E" },
          { light: "#E6D9C9", dark: "#1E1915" }
        ],
        stops: [0, 1],
        startPoint: { x: 0, y: 0 },
        endPoint: { x: 1, y: 1 }
      },
      children: [
        {
          type: "text",
          text: "Countdown",
          font: { size: "caption2", weight: "medium" },
          textColor: { light: "#8A7B6A", dark: "#BAAA99" },
          maxLines: 1
        },
        {
          type: "spacer"
        },
        {
          type: "text",
          text: "No target configured",
          font: { size: "headline", weight: "semibold" },
          textColor: { light: "#332B24", dark: "#F0E5D9" },
          maxLines: 1,
          minScale: 0.7
        },
        {
          type: "text",
          text: "Use NAME1 / DATE1 / DETAIL1",
          font: { size: "caption1", weight: "regular" },
          textColor: { light: "#786D62", dark: "#B7AA9C" },
          maxLines: 2,
          minScale: 0.7
        },
        {
          type: "spacer"
        }
      ]
    };
  }

  const children = [
    {
      type: "stack",
      direction: "row",
      alignItems: "center",
      children: [
        {
          type: "text",
          text: "Countdown",
          font: { size: "caption2", weight: "medium" },
          textColor: { light: "#8A7B6A", dark: "#BAAA99" },
          maxLines: 1
        },
        { type: "spacer" },
        {
          type: "text",
          text: String(items.length) + " ITEMS",
          font: { size: "caption2", weight: "medium" },
          textColor: { light: "#9A8B7B", dark: "#AE9E8E" },
          maxLines: 1
        }
      ]
    }
  ];

  for (let i = 0; i < visible.length; i++) {
    children.push(card(visible[i], family === "systemSmall" || family === "systemMedium"));
  }

  return {
    type: "widget",
    padding: family === "systemLarge" || family === "systemExtraLarge" ? 14 : 13,
    gap: family === "systemLarge" || family === "systemExtraLarge" ? 10 : 8,
    backgroundGradient: {
      type: "linear",
      colors: [
        { light: "#F5EEE4", dark: "#2B241E" },
        { light: "#E6D9C9", dark: "#1E1915" }
      ],
      stops: [0, 1],
      startPoint: { x: 0, y: 0 },
      endPoint: { x: 1, y: 1 }
    },
    children: children
  };
}
