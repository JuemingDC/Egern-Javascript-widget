export default async function (ctx) {
  const env = ctx.env || {};
  const family = ctx.widgetFamily || "systemMedium";

  function parseDate(input) {
    if (!input) return null;
    const t = String(input).replace(/\./g, "-").replace(/\//g, "-");
    const d = new Date(t);
    return isNaN(d) ? null : d;
  }

  function sod(d){ return new Date(d.getFullYear(),d.getMonth(),d.getDate()); }

  function daysLeft(t){
    if(!t) return null;
    const diff = Math.ceil((sod(t)-sod(new Date()))/86400000);
    return diff<0?0:diff;
  }

  function shortDate(d){
    if(!d) return "--.--";
    return `${String(d.getMonth()+1).padStart(2,"0")}.${String(d.getDate()).padStart(2,"0")}`;
  }

  function relative(d){
    if(d==null) return "pending";
    if(d==0) return "today";
    if(d==1) return "tomorrow";
    if(d<7) return `in ${d} days`;
    if(d<30) return `${d} days left`;
    return "scheduled";
  }

  function ratio(d){
    if(d==null) return 0.2;
    if(d==0) return 1;
    const c = Math.min(d,60);
    return (60-c)/60;
  }

  function tone(d){
    if(d<=3) return {c:"#C95A4B"};
    if(d<=14) return {c:"#C18A38"};
    if(d<=30) return {c:"#7E95B3"};
    return {c:"#9AA3B1"};
  }

  const list=[];
  for(let i=1;i<=20;i++){
    const n=env["NAME"+i];
    const dt=env["DATE"+i];
    const de=env["DETAIL"+i];
    if(!n&&!dt&&!de) continue;
    const p=parseDate(dt);
    list.push({
      name:n||"Target",
      detail:de||"",
      d:p,
      days:daysLeft(p),
      sd:shortDate(p)
    });
  }

  list.sort((a,b)=>(a.days??9999)-(b.days??9999));

  const max = family==="systemSmall"?1:family==="systemMedium"?2:family==="systemLarge"?3:4;

  function block(it){

    const t=tone(it.days);
    const r=ratio(it.days);
    const w=260;
    const fill=Math.max(24,Math.round(w*r));

    return {
      type:"stack",
      direction:"column",
      gap:8,
      padding:[12,0,12,0],
      children:[

        {
          type:"stack",
          direction:"row",
          children:[
            {
              type:"spacer"
            },
            {
              type:"text",
              text:it.days==null?"--":it.days+"d",
              font:{size:"systemLarge",weight:"bold"},
              textColor:t.c
            }
          ]
        },

        {
          type:"text",
          text:it.name,
          font:{size:"title2",weight:"bold"},
          textColor:{light:"#1F1A16",dark:"#F3E9DD"},
          maxLines:1,
          minScale:0.5
        },

        {
          type:"text",
          text:it.detail||" ",
          font:{size:"caption1"},
          textColor:{light:"#857A6E",dark:"#B7A898"}
        },

        {
          type:"stack",
          height:6,
          backgroundColor:{light:"#E9DED2",dark:"#463A31"},
          borderRadius:999,
          children:[
            {
              type:"stack",
              width:fill,
              height:6,
              backgroundColor:t.c,
              borderRadius:999
            }
          ]
        },

        {
          type:"text",
          text:`${it.sd} · ${relative(it.days)}`,
          font:{size:"caption1",weight:"medium"},
          textColor:t.c
        }

      ]
    };

  }

  const children=[
    {
      type:"stack",
      direction:"row",
      children:[
        {
          type:"text",
          text:"COUNTDOWN",
          font:{size:"caption2",weight:"semibold"},
          textColor:{light:"#9B8E7F",dark:"#AFA08F"}
        },
        {type:"spacer"},
        {
          type:"text",
          text:list.length+"",
          font:{size:"caption2"},
          textColor:{light:"#B2A493",dark:"#8D7E6C"}
        }
      ]
    }
  ];

  list.slice(0,max).forEach(it=>{
    children.push(block(it));
  });

  return {
    type:"widget",
    padding:14,
    gap:6,
    backgroundGradient:{
      type:"linear",
      colors:[
        {light:"#F4EDE2",dark:"#2A231C"},
        {light:"#E8DCCE",dark:"#1D1813"}
      ],
      stops:[0,1],
      startPoint:{x:0,y:0},
      endPoint:{x:1,y:1}
    },
    children
  };

}
