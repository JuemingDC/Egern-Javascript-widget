export default async function (ctx) {
  const env = ctx.env || {};
  const family = ctx.widgetFamily || "systemMedium";

  function parseDate(input) {
    if (!input) return null;
    const t = String(input).trim().replace(/\//g, "-").replace(/\./g, "-");
    const m = t.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
    if (m) return new Date(m[1], m[2]-1, m[3]);
    const d = new Date(t);
    return isNaN(d) ? null : d;
  }

  function sod(d){ return new Date(d.getFullYear(),d.getMonth(),d.getDate()); }

  function leftDays(t){
    if(!t) return null;
    const diff = Math.ceil((sod(t)-sod(new Date()))/86400000);
    return diff<0?0:diff;
  }

  function fmt(d){
    if(!d) return "Invalid";
    return `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,"0")}.${String(d.getDate()).padStart(2,"0")}`;
  }

  function items(){
    const a=[];
    for(let i=1;i<=20;i++){
      const n=env["NAME"+i];
      const dt=env["DATE"+i];
      const de=env["DETAIL"+i];
      if(!n&&!dt&&!de) continue;
      const p=parseDate(dt);
      a.push({name:n||"Target",detail:de||"",dateText:fmt(p),days:leftDays(p)});
    }
    a.sort((x,y)=>(x.days??9999)-(y.days??9999));
    return a;
  }

  function tone(d){
    if(d==null) return {num:{light:"#8f8376",dark:"#d9c7b2"},sub:{light:"#9e9182",dark:"#7a6a59"},line:{light:"#ddd2c5",dark:"#4b4036"}};
    if(d<=3) return {num:{light:"#b3473b",dark:"#f1a399"},sub:{light:"#c77a70",dark:"#8a4c45"},line:{light:"#e6bdb6",dark:"#603b35"}};
    if(d<=14) return {num:{light:"#ae7a2e",dark:"#e7c27e"},sub:{light:"#b79862",dark:"#7c633d"},line:{light:"#e3d2b4",dark:"#5a4930"}};
    if(d<=30) return {num:{light:"#6e809b",dark:"#c0ccdb"},sub:{light:"#8c99ad",dark:"#657386"},line:{light:"#cfd7e4",dark:"#455162"}};
    return {num:{light:"#7e8796",dark:"#c6cdd7"},sub:{light:"#9aa3b0",dark:"#6b717b"},line:{light:"#dcdfe5",dark:"#484c55"}};
  }

  function row(it,compact){
    const t=tone(it.days);
    return {
      type:"stack",
      direction:"column",
      gap:6,
      padding:[10,4,10,4],
      children:[
        {
          type:"stack",
          direction:"row",
          alignItems:"start",
          children:[
            {
              type:"stack",
              direction:"column",
              flex:1,
              gap:2,
              children:[
                {
                  type:"text",
                  text:it.dateText,
                  font:{size:compact?"caption1":"body",weight:"medium"},
                  textColor:t.sub,
                  textAlign:"left",
                  maxLines:1
                },
                {
                  type:"text",
                  text:it.name,
                  font:{size:compact?"headline":"title3",weight:"bold"},
                  textColor:{light:"#241e19",dark:"#f5ebe0"},
                  textAlign:"left",
                  maxLines:1,
                  minScale:0.6
                },
                {
                  type:"text",
                  text:it.detail||" ",
                  font:{size:"caption1",weight:"regular"},
                  textColor:{light:"#85786b",dark:"#b9aa99"},
                  textAlign:"left",
                  maxLines:1,
                  minScale:0.7
                }
              ]
            },
            {
              type:"stack",
              direction:"row",
              alignItems:"start",
              padding:[0,0,8,0],
              children:[
                {
                  type:"text",
                  text:it.days==null?"--":String(it.days),
                  font:{size:compact?"largeTitle":"title",weight:"bold"},
                  textColor:t.num,
                  maxLines:1,
                  minScale:0.5
                },
                {
                  type:"text",
                  text:"d",
                  font:{size:"caption2",weight:"semibold"},
                  textColor:t.sub
                }
              ]
            }
          ]
        },
        {
          type:"stack",
          height:1,
          backgroundColor:t.line
        }
      ]
    };
  }

  const list=items();
  const compact = family==="systemSmall"||family==="systemMedium";

  const children=[
    {
      type:"stack",
      direction:"row",
      children:[
        {
          type:"text",
          text:"Countdown",
          font:{size:"caption2",weight:"medium"},
          textColor:{light:"#8c7d6c",dark:"#baaa98"}
        },
        {type:"spacer"}
      ]
    }
  ];

  const max = family==="systemSmall"?1:family==="systemMedium"?2:family==="systemLarge"?4:6;

  list.slice(0,max).forEach(it=>children.push(row(it,compact)));

  return {
    type:"widget",
    padding:13,
    gap:4,
    backgroundGradient:{
      type:"linear",
      colors:[
        {light:"#f4ede2",dark:"#2a231c"},
        {light:"#e8dcce",dark:"#1d1813"}
      ],
      stops:[0,1],
      startPoint:{x:0,y:0},
      endPoint:{x:1,y:1}
    },
    children
  };
}
