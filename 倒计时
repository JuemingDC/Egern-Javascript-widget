export default async function (ctx) {
  const env = ctx.env || {};
  const family = ctx.widgetFamily || "systemMedium";

  function parseDate(input) {
    if (!input) return null;
    const text = String(input).trim().replace(/\//g, "-").replace(/\./g, "-");
    const m = text.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
    if (m) {
      const y = Number(m[1]);
      const mo = Number(m[2]) - 1;
      const d = Number(m[3]);
      const dt = new Date(y, mo, d);
      return isNaN(dt.getTime()) ? null : dt;
    }
    const dt = new Date(text);
    return isNaN(dt.getTime()) ? null : dt;
  }

  function startOfDay(dt) {
    return new Date(dt.getFullYear(), dt.getMonth(), dt.getDate());
  }

  function getDaysLeft(target) {
    if (!target) return null;
    const today = startOfDay(new Date());
    const targetDay = startOfDay(target);
    const diff = Math.ceil((targetDay.getTime() - today.getTime()) / 86400000);
    return diff < 0 ? 0 : diff;
  }

  function formatDate(dt) {
    if (!dt) return "Invalid";
    const y = dt.getFullYear();
    const m = String(dt.getMonth() + 1).padStart(2, "0");
    const d = String(dt.getDate()).padStart(2, "0");
    return `${y}.${m}.${d}`;
  }

  function getItems() {
    const list = [];

    for (let i = 1; i <= 20; i++) {
      const name = env["NAME" + i];
      const date = env["DATE" + i];
      const detail = env["DETAIL" + i];

      if (!name && !date && !detail) continue;

      const dt = parseDate(date);
      list.push({
        name: name || ("Target " + i),
        detail: detail || "",
        date: dt,
        dateText: formatDate(dt),
        days: getDaysLeft(dt),
      });
    }

    if (list.length === 0 && (env.NAME || env.DATE || env.DETAIL)) {
      const dt = parseDate(env.DATE);
      list.push({
        name: env.NAME || "Target",
        detail: env.DETAIL || "",
        date: dt,
        dateText: formatDate(dt),
        days: getDaysLeft(dt),
      });
    }

    list.sort((a, b) => {
      const ad = a.days === null ? 999999 : a.days;
      const bd = b.days === null ? 999999 : b.days;
      return ad - bd;
    });

    return list;
  }

  function getMaxCount(family) {
    if (family === "systemSmall") return 1;
    if (family === "systemMedium") return 2;
    if (family === "systemLarge") return 4;
    if (family === "systemExtraLarge") return 6;
    return 2;
  }

  // 仅用颜色区分紧急程度
  function getTone(days) {
    if (days === null) {
      return {
        cardBg: { light: "#F6F1E8", dark: "#2C2621" },
        accent: { light: "#8B8176", dark: "#C8B8A8" },
        accentSoft: { light: "#E8DED2", dark: "#433930" },
        numberBg: { light: "#EEE6DC", dark: "#3B322B" }
      };
    }
    if (days <= 3) {
      return {
        cardBg: { light: "#F8ECE8", dark: "#342422" },
        accent: { light: "#B14B3E", dark: "#F2A59A" },
        accentSoft: { light: "#EEC9C1", dark: "#5A3934" },
        numberBg: { light: "#F3DBD5", dark: "#4B2E2B" }
      };
    }
    if (days <= 14) {
      return {
        cardBg: { light: "#F6EFE5", dark: "#32281F" },
        accent: { light: "#B07A37", dark: "#E7C38C" },
        accentSoft: { light: "#E8D6B8", dark: "#5A4830" },
        numberBg: { light: "#F1E6D3", dark: "#473827" }
      };
    }
    if (days <= 30) {
      return {
        cardBg: { light: "#EEF1F6", dark: "#252C35" },
        accent: { light: "#6E7E98", dark: "#BDC9D9" },
        accentSoft: { light: "#D5DDE8", dark: "#3D4755" },
        numberBg: { light: "#E3EAF3", dark: "#323C49" }
      };
    }
    return {
      cardBg: { light: "#F2F3F5", dark: "#25272B" },
      accent: { light: "#7A8597", dark: "#C2CAD7" },
      accentSoft: { light: "#DCE2EA", dark: "#3B414B" },
      numberBg: { light: "#E9EDF2", dark: "#31353C" }
    };
  }

  function makeCard(item, compact) {
    const tone = getTone(item.days);

    return {
      type: "stack",
      direction: "row",
      alignItems: "center",
      padding: compact ? [12, 14, 12, 14] : [14, 16, 14, 16],
      backgroundColor: tone.cardBg,
      borderRadius: 20,
      children: [
        {
          type: "stack",
          direction: "row",
          alignItems: "center",
          flex: 1,
          children: [
            {
              type: "stack",
              direction: "row",
              alignItems: "center",
              gap: 6,
              width: compact ? 92 : 108,
              children: [
                {
                  type: "image",
                  src: "sf-symbol:calendar",
                  color: tone.accent,
                  width: compact ? 13 : 14,
                  height: compact ? 13 : 14
                },
                {
                  type: "text",
                  text: item.dateText,
                  font: { size: compact ? "caption1" : "body", weight: "medium" },
                  textColor: { light: "#5D544A", dark: "#D2C5B6" },
                  maxLines: 1,
                  minScale: 0.7
                }
              ]
            },

            {
              type: "stack",
              direction: "column",
              flex: 1,
              alignItems: "center",
              children: [
                {
                  type: "text",
                  text: item.name,
                  font: { size: compact ? "body" : "headline", weight: "semibold" },
                  textColor: { light: "#2E2721", dark: "#F3E9DE" },
                  maxLines: 1,
                  minScale: 0.65
                },
                {
                  type: "text",
                  text: item.detail || " ",
                  font: { size: "caption1", weight: "regular" },
                  textColor: { light: "#827669", dark: "#BDAF9F" },
                  maxLines: 1,
                  minScale: 0.7
                }
              ]
            },

            {
              type: "stack",
              direction: "column",
              alignItems: "end",
              width: compact ? 52 : 64,
              children: [
                {
                  type: "stack",
                  padding: compact ? [4, 9, 4, 9] : [5, 11, 5, 11],
                  backgroundColor: tone.numberBg,
                  borderRadius: 999,
                  children: [
                    {
                      type: "text",
                      text: item.days === null ? "--" : String(item.days),
                      font: { size: compact ? "title3" : "title2", weight: "bold" },
                      textColor: tone.accent,
                      maxLines: 1,
                      minScale: 0.55
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    };
  }

  const items = getItems();
  const visible = items.slice(0, getMaxCount(family));
  const compact = family === "systemSmall" || family === "systemMedium";

  if (items.length === 0) {
    return {
      type: "widget",
      padding: 14,
      gap: 10,
      backgroundGradient: {
        type: "linear",
        colors: [
          { light: "#F4EDE2", dark: "#2A231C" },
          { light: "#E8DCCE", dark: "#1D1813" }
        ],
        stops: [0, 1],
        startPoint: { x: 0, y: 0 },
        endPoint: { x: 1, y: 1 }
      },
      children: [
        {
          type: "stack",
          direction: "row",
          children: [
            {
              type: "text",
              text: "Countdown",
              font: { size: "caption2", weight: "medium" },
              textColor: { light: "#8C7D6C", dark: "#BAAA98" },
              maxLines: 1
            },
            { type: "spacer" }
          ]
        },
        { type: "spacer" },
        {
          type: "text",
          text: "No target configured",
          font: { size: "headline", weight: "semibold" },
          textColor: { light: "#302821", dark: "#F0E5D9" },
          maxLines: 1,
          minScale: 0.7
        },
        {
          type: "text",
          text: "Use NAME1 / DATE1 / DETAIL1",
          font: { size: "caption1", weight: "regular" },
          textColor: { light: "#7B6E61", dark: "#B6A899" },
          maxLines: 2
        },
        { type: "spacer" }
      ]
    };
  }

  const children = [
    {
      type: "stack",
      direction: "row",
      alignItems: "center",
      children: [
        {
          type: "text",
          text: "Countdown",
          font: { size: "caption2", weight: "medium" },
          textColor: { light: "#8C7D6C", dark: "#BAAA98" },
          maxLines: 1
        },
        { type: "spacer" },
        {
          type: "text",
          text: `${items.length} ITEMS`,
          font: { size: "caption2", weight: "medium" },
          textColor: { light: "#A09081", dark: "#AD9D8D" },
          maxLines: 1
        }
      ]
    }
  ];

  for (let i = 0; i < visible.length; i++) {
    children.push(makeCard(visible[i], compact));
  }

  return {
    type: "widget",
    padding: family === "systemLarge" || family === "systemExtraLarge" ? 14 : 13,
    gap: family === "systemLarge" || family === "systemExtraLarge" ? 10 : 8,
    backgroundGradient: {
      type: "linear",
      colors: [
        { light: "#F4EDE2", dark: "#2A231C" },
        { light: "#E8DCCE", dark: "#1D1813" }
      ],
      stops: [0, 1],
      startPoint: { x: 0, y: 0 },
      endPoint: { x: 1, y: 1 }
    },
    children: children
  };
}
