export default async function(ctx) {
  const env = ctx.env || {};
  const family = ctx.widgetFamily || 'systemMedium';

  // ========= 工具函数 =========
  function pad(n) {
    return String(n).padStart(2, '0');
  }

  function toDateOnly(date) {
    return new Date(date.getFullYear(), date.getMonth(), date.getDate());
  }

  function parseDate(input) {
    if (!input) return null;

    // 支持 YYYY-MM-DD / YYYY/MM/DD / ISO
    const normalized = String(input).trim().replace(/\./g, '-').replace(/\//g, '-');

    // 纯日期按本地 00:00:00 处理，避免时区误差
    const m = normalized.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
    if (m) {
      const y = Number(m[1]);
      const mo = Number(m[2]) - 1;
      const d = Number(m[3]);
      const dt = new Date(y, mo, d);
      return isNaN(dt.getTime()) ? null : dt;
    }

    const dt = new Date(normalized);
    return isNaN(dt.getTime()) ? null : dt;
  }

  function formatDate(dt) {
    if (!dt) return 'Invalid date';
    return `${dt.getFullYear()}.${pad(dt.getMonth() + 1)}.${pad(dt.getDate())}`;
  }

  function diffDays(target) {
    if (!target) return null;

    const now = new Date();
    const today = toDateOnly(now);
    const targetDay = toDateOnly(target);

    // 按“自然日”计算，到目标日当天显示 0 天
    const ms = targetDay.getTime() - today.getTime();
    const days = Math.ceil(ms / 86400000);

    return days < 0 ? 0 : days;
  }

  function urgency(days) {
    if (days === null) {
      return {
        accent: '#8C8475',
        accentSoft: '#D8D1C4',
        pillBg: '#F2EEE8',
        line: '#D8CFC1',
        icon: '#7E7468'
      };
    }
    if (days <= 3) {
      return {
        accent: '#A43A2A',
        accentSoft: '#E9C0B1',
        pillBg: '#F8E7E1',
        line: '#D9A595',
        icon: '#A43A2A'
      };
    }
    if (days <= 14) {
      return {
        accent: '#B06A2B',
        accentSoft: '#E6CFB2',
        pillBg: '#F7EFE4',
        line: '#D7BB95',
        icon: '#A36A32'
      };
    }
    if (days <= 30) {
      return {
        accent: '#6F7C4B',
        accentSoft: '#D7DFC2',
        pillBg: '#EEF2E5',
        line: '#BAC7A0',
        icon: '#66734A'
      };
    }
    return {
      accent: '#5C6B86',
      accentSoft: '#D4DCEA',
      pillBg: '#EEF2F8',
      line: '#BCC7D8',
      icon: '#5C6B86'
    };
  }

  function getItems() {
    const items = [];
    for (let i = 1; i <= 20; i++) {
      const name = env[`NAME${i}`];
      const date = env[`DATE${i}`];
      const detail = env[`DETAIL${i}`];

      if (!name && !date && !detail) continue;

      const parsed = parseDate(date);
      const days = diffDays(parsed);

      items.push({
        index: i,
        name: name || `Target ${i}`,
        dateRaw: date || '',
        date: parsed,
        dateText: formatDate(parsed),
        detail: detail || '',
        days
      });
    }

    // 没传编号变量时，兼容单目标 NAME / DATE / DETAIL
    if (items.length === 0 && (env.NAME || env.DATE || env.DETAIL)) {
      const parsed = parseDate(env.DATE);
      items.push({
        index: 1,
        name: env.NAME || 'Target',
        dateRaw: env.DATE || '',
        date: parsed,
        dateText: formatDate(parsed),
        detail: env.DETAIL || '',
        days: diffDays(parsed)
      });
    }

    items.sort((a, b) => {
      const ad = a.days === null ? Number.MAX_SAFE_INTEGER : a.days;
      const bd = b.days === null ? Number.MAX_SAFE_INTEGER : b.days;
      return ad - bd;
    });

    return items;
  }

  const items = getItems();

  function maxCountForFamily() {
    switch (family) {
      case 'systemSmall':
        return 1;
      case 'systemMedium':
        return 2;
      case 'systemLarge':
      case 'systemExtraLarge':
        return 4;
      case 'accessoryRectangular':
        return 1;
      case 'accessoryCircular':
        return 1;
      case 'accessoryInline':
        return 1;
      default:
        return 2;
    }
  }

  const visible = items.slice(0, maxCountForFamily());

  function titleBlock() {
    return {
      type: 'stack',
      direction: 'row',
      alignItems: 'start',
      children: [
        {
          type: 'text',
          text: 'Countdown',
          font: { size: 'caption2', weight: 'medium' },
          textColor: '#7F7468',
          opacity: 0.72,
          maxLines: 1,
          minScale: 0.8
        },
        { type: 'spacer' },
        items.length > 0
          ? {
              type: 'text',
              text: `${items.length} ITEMS`,
              font: { size: 'caption2', weight: 'medium' },
              textColor: '#9A8F82',
              opacity: 0.7,
              maxLines: 1,
              minScale: 0.8
            }
          : {
              type: 'text',
              text: 'EMPTY',
              font: { size: 'caption2', weight: 'medium' },
              textColor: '#9A8F82',
              opacity: 0.7,
              maxLines: 1
            }
      ]
    };
  }

  function bigDayNumber(days, palette) {
    return {
      type: 'stack',
      direction: 'column',
      alignItems: 'end',
      gap: 0,
      children: [
        {
          type: 'text',
          text: days === null ? '--' : String(days),
          font: { size: 'title1', weight: 'bold' },
          textColor: palette.accent,
          maxLines: 1,
          minScale: 0.5
        },
        {
          type: 'text',
          text: 'days',
          font: { size: 'caption1', weight: 'medium' },
          textColor: '#7F7468',
          opacity: 0.82,
          maxLines: 1
        }
      ]
    };
  }

  function itemCard(item, compact = false) {
    const palette = urgency(item.days);

    return {
      type: 'stack',
      direction: 'column',
      gap: compact ? 6 : 8,
      padding: compact ? [10, 12, 10, 12] : [12, 14, 12, 14],
      backgroundColor: '#FFFDF9',
      borderRadius: 18,
      borderWidth: 1,
      borderColor: palette.line,
      shadowColor: '#00000022',
      shadowRadius: 8,
      shadowOffset: { x: 0, y: 2 },
      children: [
        {
          type: 'stack',
          direction: 'row',
          alignItems: 'start',
          children: [
            {
              type: 'stack',
              direction: 'column',
              gap: 3,
              flex: 1,
              children: [
                {
                  type: 'text',
                  text: item.name,
                  font: { size: compact ? 'body' : 'headline', weight: 'semibold' },
                  textColor: '#2F2721',
                  maxLines: compact ? 1 : 2,
                  minScale: 0.65
                },
                item.detail
                  ? {
                      type: 'text',
                      text: item.detail,
                      font: { size: 'caption1', weight: 'regular' },
                      textColor: '#786D62',
                      opacity: 0.92,
                      maxLines: compact ? 1 : 2,
                      minScale: 0.72
                    }
                  : {
                      type: 'text',
                      text: ' ',
                      font: { size: 'caption1', weight: 'regular' },
                      textColor: '#786D62',
                      opacity: 0
                    }
              ]
            },
            { type: 'spacer', length: 8 },
            bigDayNumber(item.days, palette)
          ]
        },
        {
          type: 'stack',
          direction: 'row',
          alignItems: 'center',
          gap: 6,
          children: [
            {
              type: 'image',
              src: 'sf-symbol:calendar',
              width: 13,
              height: 13,
              color: palette.icon
            },
            {
              type: 'text',
              text: item.dateText,
              font: { size: 'caption1', weight: 'medium' },
              textColor: '#5C5249',
              maxLines: 1,
              minScale: 0.8
            },
            { type: 'spacer' },
            {
              type: 'stack',
              padding: [4, 8, 4, 8],
              backgroundColor: palette.pillBg,
              borderRadius: 999,
              children: [
                {
                  type: 'text',
                  text:
                    item.days === null
                      ? 'Invalid'
                      : item.days === 0
                      ? 'Today'
                      : item.days <= 3
                      ? 'Urgent'
                      : item.days <= 14
                      ? 'Upcoming'
                      : 'Planned',
                  font: { size: 'caption2', weight: 'medium' },
                  textColor: palette.accent,
                  maxLines: 1
                }
              ]
            }
          ]
        }
      ]
    };
  }

  function emptyState() {
    return {
      type: 'stack',
      direction: 'column',
      gap: 10,
      flex: 1,
      alignItems: 'center',
      children: [
        { type: 'spacer' },
        {
          type: 'image',
          src: 'sf-symbol:calendar.badge.exclamationmark',
          width: 26,
          height: 26,
          color: '#8A7E73'
        },
        {
          type: 'text',
          text: 'No target found',
          font: { size: 'headline', weight: 'semibold' },
          textColor: '#40362F',
          maxLines: 1
        },
        {
          type: 'text',
          text: 'Use NAME1 / DATE1 / DETAIL1\nand continue with NAME2 / DATE2 / DETAIL2',
          font: { size: 'caption1', weight: 'regular' },
          textColor: '#7C7065',
          textAlign: 'center',
          maxLines: 3,
          minScale: 0.75
        },
        { type: 'spacer' }
      ]
    };
  }

  // ========= 锁屏样式 =========
  if (family === 'accessoryInline') {
    const item = visible[0];
    return {
      type: 'widget',
      children: [
        {
          type: 'text',
          text: item
            ? `${item.name} · ${item.days === null ? '--' : item.days}天`
            : 'Countdown · 未配置'
        }
      ]
    };
  }

  if (family === 'accessoryRectangular') {
    const item = visible[0];
    const palette = urgency(item?.days ?? null);

    return {
      type: 'widget',
      padding: 10,
      backgroundColor: '#F7F2EA',
      children: item
        ? [
            {
              type: 'stack',
              direction: 'column',
              gap: 4,
              children: [
                {
                  type: 'text',
                  text: item.name,
                  font: { size: 'body', weight: 'semibold' },
                  textColor: '#2F2721',
                  maxLines: 1,
                  minScale: 0.7
                },
                {
                  type: 'stack',
                  direction: 'row',
                  children: [
                    {
                      type: 'text',
                      text: `${item.days === null ? '--' : item.days}天`,
                      font: { size: 'headline', weight: 'bold' },
                      textColor: palette.accent,
                      maxLines: 1
                    },
                    { type: 'spacer' },
                    {
                      type: 'text',
                      text: item.dateText,
                      font: { size: 'caption2', weight: 'medium' },
                      textColor: '#786D62',
                      maxLines: 1
                    }
                  ]
                }
              ]
            }
          ]
        : [
            {
              type: 'text',
              text: '请配置 NAME1 / DATE1 / DETAIL1',
              font: { size: 'caption1', weight: 'medium' },
              textColor: '#5C5249',
              maxLines: 2
            }
          ]
    };
  }

  if (family === 'accessoryCircular') {
    const item = visible[0];
    const palette = urgency(item?.days ?? null);

    return {
      type: 'widget',
      children: [
        {
          type: 'stack',
          direction: 'column',
          alignItems: 'center',
          gap: 1,
          children: [
            {
              type: 'text',
              text: item ? String(item.days === null ? '--' : item.days) : '--',
              font: { size: 'title3', weight: 'bold' },
              textColor: palette.accent,
              maxLines: 1,
              minScale: 0.5
            },
            {
              type: 'text',
              text: 'days',
              font: { size: 'caption2', weight: 'medium' },
              textColor: '#7F7468',
              maxLines: 1
            }
          ]
        }
      ]
    };
  }

  // ========= 主屏样式 =========
  const isSmall = family === 'systemSmall';
  const isMedium = family === 'systemMedium';
  const isLarge = family === 'systemLarge' || family === 'systemExtraLarge';

  let contentChildren = [];

  if (visible.length === 0) {
    contentChildren = [emptyState()];
  } else if (isSmall) {
    contentChildren = [itemCard(visible[0], true)];
  } else if (isMedium) {
    contentChildren = visible.map((item) => itemCard(item, true));
  } else if (isLarge) {
    contentChildren = [];
    for (let i = 0; i < visible.length; i++) {
      contentChildren.push(itemCard(visible[i], false));
    }
  } else {
    contentChildren = visible.map((item) => itemCard(item, true));
  }

  return {
    type: 'widget',
    padding: isLarge ? [14, 14, 14, 14] : [13, 13, 13, 13],
    gap: isLarge ? 10 : 8,
    backgroundGradient: {
      colors: ['#F5EFE6', '#E8DDD0'],
      locations: [0, 1]
    },
    children: [
      titleBlock(),
      ...contentChildren
    ]
  };
}
